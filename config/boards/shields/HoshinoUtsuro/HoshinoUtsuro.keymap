#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp Q           &kp W           &kp E           &kp R           &kp T
        &kp A           &kp S           &kp D           &lt 1 F          &kp G
        &kp Z           &kp X           &kp C           &kp V           &kp B
        &kp Y           &kp U           &kp I           &kp O           &kp P
        &kp H           &lt 1 J          &kp K           &kp L           &kp ENTER
        &kp N           &kp M           &kp FSLH        &kp SPACE       &kp C_MUTE
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    symbol_layer {
      bindings = <
        &kp LS(N1)      &kp LS(N2)      &kp LS(N3)      &kp LS(N4)      &kp LS(N5)
        &kp LS(N8)      &kp RBKT        &kp RBRC        &trans          &kp LS(SEMI)
        &kp LS(N9)      &kp BSLH        &kp LS(BSLH)    &kp SPACE       &kp NUBS
        &kp LS(N6)      &kp LS(EQUAL)   &kp COLON       &kp MINUS       &kp UNDER
        &kp SEMI        &trans          &kp LS(COLON)   &kp LBKT        &trans
        &kp SPACE       &kp LS(FSLH)    &kp UNDER       &trans          &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
  };
};
