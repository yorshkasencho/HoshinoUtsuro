#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define DEF 0
#define NUM 1
#define SYM 2
#define NAV 3
#define DRAW 4

/ {
    behaviors {
        hm: hold_mod_120 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_MOD_120";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        ble_0: ble_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to DEF>;
        };

        ble_1: ble_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to DRAW>;
        };

        ble_2: ble_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&to DEF>;
        };

        ble_3: ble_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&to DEF>;
        };

        ble_4: ble_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&to DEF>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* 共通BLEコンボ */
        combo_ble0 {
            timeout-ms = <50>;
            key-positions = <14 15 9>;      /* G H P位置 */
            bindings = <&ble_0>;
            layers = <DEF NUM SYM NAV DRAW>;
        };

        combo_ble1 {
            timeout-ms = <50>;
            key-positions = <14 15 18>;     /* G H L位置 */
            bindings = <&ble_1>;
            layers = <DEF NUM SYM NAV DRAW>;
        };

        combo_ble2 {
            timeout-ms = <50>;
            key-positions = <14 15 26>;     /* G H /?位置 */
            bindings = <&ble_2>;
            layers = <DEF NUM SYM NAV DRAW>;
        };

        combo_ble3 {
            timeout-ms = <50>;
            key-positions = <14 15 8>;      /* G H O位置 */
            bindings = <&ble_3>;
            layers = <DEF NUM SYM NAV DRAW>;
        };

        combo_ble4 {
            timeout-ms = <50>;
            key-positions = <14 15 25>;     /* G H M位置 */
            bindings = <&ble_4>;
            layers = <DEF NUM SYM NAV DRAW>;
        };

        combo_bt_clr {
            timeout-ms = <50>;
            key-positions = <14 15 17>;     /* G H K位置 */
            bindings = <&bt BT_CLR>;
            layers = <DEF NUM SYM NAV DRAW>;
        };

        combo_draw_toggle {
            timeout-ms = <50>;
            key-positions = <14 15 23>;     /* G H B位置 */
            bindings = <&tog DRAW>;
            layers = <DEF NUM SYM NAV DRAW>;
        };

        /* 通常モードコンボ */
        combo_esc {
            timeout-ms = <40>;
            key-positions = <0 1>;          /* Q W */
            bindings = <&kp ESC>;
            layers = <DEF>;
        };

        combo_tab {
            timeout-ms = <40>;
            key-positions = <10 1>;         /* A W */
            bindings = <&kp TAB>;
            layers = <DEF>;
        };

        combo_caps {
            timeout-ms = <40>;
            key-positions = <19 1>;         /* Z W */
            bindings = <&kp CAPS>;
            layers = <DEF>;
        };

        combo_kana {
            timeout-ms = <40>;
            key-positions = <6 7>;          /* U I */
            bindings = <&kp LANG1>;
            layers = <DEF>;
        };

        combo_eisu {
            timeout-ms = <40>;
            key-positions = <2 3>;          /* E R */
            bindings = <&kp LANG2>;
            layers = <DEF>;
        };

        combo_op_p {
            timeout-ms = <40>;
            key-positions = <8 9>;          /* O P */
            bindings = <&kp P>;
            layers = <DEF>;
        };

        combo_kl_l {
            timeout-ms = <40>;
            key-positions = <17 18>;        /* K L位置 */
            bindings = <&kp L>;
            layers = <DEF>;
        };

        combo_lo_minus {
            timeout-ms = <40>;
            key-positions = <18 8>;         /* L位置 O */
            bindings = <&kp MINUS>;
            layers = <DEF>;
        };

        combo_nm_comma {
            timeout-ms = <40>;
            key-positions = <24 25>;        /* N M */
            bindings = <&kp COMMA>;
            layers = <DEF>;
        };

        combo_m_slash_dot {
            timeout-ms = <40>;
            key-positions = <25 26>;        /* M /? */
            bindings = <&kp DOT>;
            layers = <DEF>;
        };

        combo_fj_space {
            timeout-ms = <40>;
            key-positions = <13 16>;        /* F J */
            bindings = <&kp SPACE>;
            layers = <DEF>;
        };

        /* 新修飾コンボ */
        combo_xc_ctrl {
            timeout-ms = <40>;
            key-positions = <20 21>;        /* X C */
            bindings = <&kp LCTRL>;
            layers = <DEF>;
        };

        combo_zc_alt {
            timeout-ms = <40>;
            key-positions = <19 21>;        /* Z C */
            bindings = <&kp LALT>;
            layers = <DEF>;
        };

        combo_zx_gui {
            timeout-ms = <40>;
            key-positions = <19 20>;        /* Z X */
            bindings = <&kp LGUI>;
            layers = <DEF>;
        };

        /* 数字即発動コンボ */
        combo_qa_1 {
            timeout-ms = <40>;
            key-positions = <0 10>;
            bindings = <&kp N1>;
            layers = <DEF>;
        };

        combo_ws_2 {
            timeout-ms = <40>;
            key-positions = <1 11>;
            bindings = <&kp N2>;
            layers = <DEF>;
        };

        combo_ed_3 {
            timeout-ms = <40>;
            key-positions = <2 12>;
            bindings = <&kp N3>;
            layers = <DEF>;
        };

        combo_rf_dot {
            timeout-ms = <40>;
            key-positions = <3 13>;
            bindings = <&kp DOT>;
            layers = <DEF>;
        };

        combo_az_4 {
            timeout-ms = <40>;
            key-positions = <10 19>;
            bindings = <&kp N4>;
            layers = <DEF>;
        };

        combo_sx_5 {
            timeout-ms = <40>;
            key-positions = <11 20>;
            bindings = <&kp N5>;
            layers = <DEF>;
        };

        combo_dc_6 {
            timeout-ms = <40>;
            key-positions = <12 21>;
            bindings = <&kp N6>;
            layers = <DEF>;
        };

        combo_fv_0 {
            timeout-ms = <40>;
            key-positions = <13 22>;
            bindings = <&kp N0>;
            layers = <DEF>;
        };

        combo_zq_7 {
            timeout-ms = <40>;
            key-positions = <19 0>;
            bindings = <&kp N7>;
            layers = <DEF>;
        };

        combo_xw_8 {
            timeout-ms = <40>;
            key-positions = <20 1>;
            bindings = <&kp N8>;
            layers = <DEF>;
        };

        combo_ce_9 {
            timeout-ms = <40>;
            key-positions = <21 2>;
            bindings = <&kp N9>;
            layers = <DEF>;
        };

        combo_vr_comma {
            timeout-ms = <40>;
            key-positions = <22 3>;
            bindings = <&kp COMMA>;
            layers = <DEF>;
        };

        /* お絵描きモード内コンボ */
        combo_draw_esc {
            timeout-ms = <40>;
            key-positions = <0 1>;          /* Q W */
            bindings = <&kp ESC>;
            layers = <DRAW>;
        };

        combo_draw_enter {
            timeout-ms = <40>;
            key-positions = <2 3>;          /* E R */
            bindings = <&kp ENTER>;
            layers = <DRAW>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &hm LSHFT Q   &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P
                &kp A         &kp S        &kp D        &lt NAV F    &kp G        &kp H        &kp J        &kp K        &lt SYM L
                &hm LCTRL Z   &hm LALT X   &hm LGUI C   &hm LALT V   &kp B        &kp N        &kp M        &lt NUM SLASH
                &kp SPACE     &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        number_layer {
            bindings = <
                &kp N1        &kp N2       &kp N3       &kp DOT      &kp PRCNT    &kp F1       &kp F2       &kp F3       &kp F4       &kp F5
                &kp N4        &kp N5       &kp N6       &kp N0       &trans       &kp F6       &kp F7       &kp F8       &kp F9
                &kp N7        &kp N8       &kp N9       &kp COMMA    &kp F10      &kp F11      &kp F12      &trans
                &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbol_layer {
            bindings = <
                &trans        &trans       &trans       &trans       &trans       &trans       &trans       &trans       &kp MINUS   &trans
                &trans        &trans       &trans       &trans       &trans       &trans       &kp STAR    &kp AT       &trans
                &trans        &trans       &trans       &trans       &trans       &trans       &kp UNDER   &kp QUESTION
                &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            bindings = <
                &kp PSCRN     &kp UP       &kp HOME     &trans       &trans       &trans       &mkp MB3     &trans       &trans       &kp DEL
                &kp LEFT      &kp DOWN     &kp RIGHT    &kp HOME     &trans       &trans       &mkp MB1     &mkp MB2     &trans
                &kp INS       &kp LS(TAB)  &kp LC(LS(TAB)) &kp TAB    &kp LC(TAB)  &trans       &trans       &trans
                &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        drawing_layer {
            bindings = <
                &kp K         &kp G        &kp J        &kp F        &kp P        &kp Y        &kp UP       &kp M        &kp C        &kp DEL
                &kp LSHFT     &kp LGUI     &kp LALT     &kp SPACE    &kp I        &kp LEFT     &kp DOWN     &kp RIGHT    &kp ENTER
                &kp X         &kp O        &kp U        &kp Q        &kp B        &kp N        &kp Z        &trans
                &kp TAB       &kp LC(TAB)
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
